{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapeptide.local/schemas/orchestrator-run-v2.json",
  "title": "NovaPeptide Orchestrator Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "orchestrator_version",
    "run_id",
    "workflow_id",
    "run_path",
    "plan",
    "status",
    "created_at",
    "updated_at",
    "approvals",
    "tasks",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "orchestrator_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^orchestrator_[0-9a-f]{12}$"},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "run_path": {"type": "string", "minLength": 1},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "plan_path", "plan_sha256", "project_id", "workflow_id"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^planner_[0-9a-f]{12}$"},
        "plan_path": {"type": "string", "minLength": 1},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "project_id": {"type": ["string", "null"]},
        "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}
      }
    },
    "status": {
      "enum": [
        "pending",
        "awaiting_approval",
        "ready",
        "running",
        "blocked",
        "failed",
        "completed_required",
        "completed"
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval_ref"}
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/task_state"}
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_lease", "gpu_minutes_consumed", "gpu_minutes_by_approval"],
      "properties": {
        "gpu_lease": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["task_id", "claim_token", "worker", "acquired_at"],
              "properties": {
                "task_id": {"$ref": "#/$defs/task_id"},
                "claim_token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
                "worker": {"type": "string", "minLength": 1},
                "acquired_at": {"type": "string", "format": "date-time"}
              }
            }
          ]
        },
        "gpu_minutes_consumed": {"type": "number", "minimum": 0},
        "gpu_minutes_by_approval": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approval_path",
        "approval_sha256",
        "approved_task_ids",
        "approver",
        "justification",
        "budget_limits"
      ],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^approval_[0-9a-f]{12}$"},
        "approval_path": {"type": "string", "minLength": 1},
        "approval_sha256": {"$ref": "#/$defs/sha256"},
        "approved_task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/task_id"}
        },
        "approver": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1},
        "budget_limits": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "producer_task_id": {"anyOf": [{"$ref": "#/$defs/task_id"}, {"type": "null"}]},
        "producer_attempt_id": {"type": ["string", "null"]},
        "schema_version": {"type": ["string", "integer", "null"]},
        "input_artifact_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts",
        "claim",
        "outputs",
        "resource_usage",
        "last_error",
        "completed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "blocked_dependency",
            "awaiting_approval",
            "pending_dependency",
            "ready",
            "claimed",
            "succeeded",
            "failed",
            "skipped"
          ]
        },
        "attempts": {"type": "integer", "minimum": 0},
        "claim": {"type": ["object", "null"]},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "resource_usage": {"type": "object"},
        "last_error": {"type": ["object", "null"]},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "attempt_history": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
