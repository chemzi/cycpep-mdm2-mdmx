{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapeptide.local/schemas/planner-approval-v1.json",
  "title": "NovaPeptide Planner Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_path",
    "plan_sha256",
    "project_id",
    "approved_task_ids",
    "approver",
    "justification",
    "budget_limits",
    "approval_id",
    "created_at",
    "authorization_semantics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^planner_[0-9a-f]{12}$"},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_id": {"type": ["string", "null"]},
    "approved_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^T[0-9]{3}$"}
    },
    "approver": {"type": "string", "minLength": 1},
    "justification": {"type": "string", "minLength": 1},
    "budget_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_gpu_job_slots", "max_design_proposals", "max_prediction_candidates"],
      "properties": {
        "max_gpu_job_slots": {"type": ["integer", "null"], "minimum": 0},
        "max_design_proposals": {"type": ["integer", "null"], "minimum": 0},
        "max_prediction_candidates": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "approval_id": {"type": "string", "pattern": "^approval_[0-9a-f]{12}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "authorization_semantics": {"type": "string", "minLength": 1}
  }
}
