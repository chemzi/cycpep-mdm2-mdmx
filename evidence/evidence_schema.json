{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cyclic peptide Agent evidence log v5",
  "description": "Append-only evidence entries for Research, Design, Prediction, Critic and Planner.",
  "type": "object",
  "required": ["timestamp", "event_id", "agent", "event_type"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": ["planner", "research", "design", "prediction", "critic", "reporter", "system"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "research_targets",
        "tool_call",
        "design_batch",
        "candidate_registered",
        "candidate_index_migrated",
        "prediction_run_started",
        "prediction_recorded",
        "prediction_handoff_ready",
        "evaluate_layer_start",
        "candidate_scored",
        "candidate_eliminated",
        "evaluate_layer_complete",
        "critic_review",
        "planner_adjust",
        "candidate_finalized",
        "error"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["research", "design", "evaluate", "critic", "iterate", "report"]
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Project target IDs; 'both' remains a legacy display value"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C\\d{4,}$"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "tool_trace": {
      "$ref": "#/$defs/tool_trace"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "sequence"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^C\\d{4,}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 20
        },
        "source_route": {
          "type": "string"
        },
        "source_batch": {
          "type": "string"
        },
        "cyclization_type": {
          "type": "string",
          "oneOf": [
            {
              "enum": ["head_to_tail_amide", "head-to-tail_amide"]
            },
            {
              "pattern": "^Cys-Cys_disulfide(?:,linker=[ACDEFGHIKLMNPQRSTVWY]*)?$"
            }
          ]
        },
        "cyclization_bonds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["atom_1", "atom_2", "bond_type"],
            "properties": {
              "atom_1": {
                "type": "string"
              },
              "atom_2": {
                "type": "string"
              },
              "bond_type": {
                "type": "string"
              }
            }
          }
        },
        "design_pdb_path": {
          "type": ["string", "null"]
        },
        "design_pdb_hash": {
          "type": ["string", "null"]
        },
        "manifest_path": {
          "type": "string"
        }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "global": {"type": "object", "additionalProperties": true},
            "targets": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/target_scores"}
            }
          }
        },
        "plddt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ipsae_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ipsae_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dg_mdm2": {
          "type": "number"
        },
        "dg_mdmx": {
          "type": "number"
        },
        "dg_method": {
          "type": "string"
        },
        "sc_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sc_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dsasa_mdm2": {
          "type": "number",
          "minimum": 0
        },
        "dsasa_mdmx": {
          "type": "number",
          "minimum": 0
        },
        "nc_distance_pre": {
          "type": "number",
          "minimum": 0
        },
        "nc_distance_post": {
          "type": "number",
          "minimum": 0
        },
        "hotspot_cov_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hotspot_cov_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pose_rmsd_mdm2": {
          "type": "number",
          "minimum": 0
        },
        "pose_rmsd_mdmx": {
          "type": "number",
          "minimum": 0
        },
        "seed_convergence_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed_convergence_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scrmsd": {
          "type": "number",
          "minimum": 0
        },
        "l1_pass": {
          "type": "boolean"
        },
        "l2_pass": {
          "type": "boolean"
        },
        "l3_pass": {
          "type": "boolean"
        },
        "l4_pass": {
          "type": "boolean"
        },
        "l5_pass": {
          "type": "boolean"
        },
        "l6_pass": {
          "type": "boolean"
        },
        "l7_pass": {
          "type": "boolean"
        },
        "all_layers_pass": {
          "type": "boolean"
        }
      }
    },
    "target_scores": {
      "type": "object",
      "properties": {
        "ipsae": {"type": "number", "minimum": 0, "maximum": 1},
        "ipae": {"type": "number", "minimum": 0},
        "iptm": {"type": "number", "minimum": 0, "maximum": 1},
        "dg": {"type": "number"},
        "sc": {"type": "number", "minimum": 0, "maximum": 1},
        "dsasa": {"type": "number", "minimum": 0},
        "hotspot_cov": {"type": "number", "minimum": 0, "maximum": 1},
        "site_consistency": {"type": ["boolean", "string"]},
        "pose_rmsd": {"type": "number", "minimum": 0},
        "seed_convergence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "tool_trace": {
      "type": "object",
      "required": ["tool_name", "exit_code"],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "input_params": {
          "type": "object"
        },
        "output_path": {
          "type": "string"
        },
        "output_hash": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_snippet": {
          "type": "string"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
