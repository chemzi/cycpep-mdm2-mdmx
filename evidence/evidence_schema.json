{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cyclic peptide Agent evidence log v5",
  "description": "Append-only Evidence Ledger entries for all workflow agents.",
  "type": "object",
  "required": ["timestamp", "event_id", "agent", "event_type"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_id": {
      "type": "string"
    },
    "agent": {
      "type": "string",
      "enum": ["orchestrator", "planner", "research", "design", "prediction", "critic", "reporter", "execution", "system"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "research_targets",
        "research_cache_invalidated",
        "threshold_calibration",
        "tool_call",
        "design_batch",
        "candidate_registered",
        "candidate_index_migrated",
        "prediction_run_started",
        "prediction_recorded",
        "prediction_handoff_ready",
        "evaluate_layer_start",
        "candidate_scored",
        "candidate_eliminated",
        "evaluate_layer_complete",
        "critic_review",
        "planner_plan",
        "planner_approval_recorded",
        "planner_adjust",
        "state_project_config_sync",
        "threshold_cache_sync",
        "orchestrator_run_initialized",
        "orchestrator_approval_loaded",
        "orchestrator_task_claimed",
        "orchestrator_task_completed",
        "orchestrator_task_failed",
        "orchestrator_task_skipped",
        "orchestrator_claim_recovered",
        "orchestrator_task_retry_requested",
        "execution_task_started",
        "execution_task_completed",
        "execution_task_failed",
        "colabdesign_verify_skipped",
        "cheap_filter_empty",
        "route_c_fallback_binder",
        "route_c_under_target",
        "mdm_legacy_defaults_active",
        "ligandmpnn_multiple_fasta",
        "ligandmpnn_fasta_no_id_marker",
        "pdb_insertion_code_detected",
        "benchmark_reference_candidate_registered",
        "candidate_finalized",
        "error",
        "test"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["research", "design", "evaluate", "critic", "iterate", "report"]
    },
    "project_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "run_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "attempt_id": {"type": "string", "pattern": "^T[0-9]{3}-A[0-9]{2,}$"},
    "parent_event_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Project target IDs; 'both' remains a legacy display value"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C\\d{4,}$"
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "tool_trace": {
      "$ref": "#/$defs/tool_trace"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "sequence"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^C\\d{4,}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        },
        "length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 20
        },
        "source_route": {
          "type": "string"
        },
        "source_batch": {
          "type": "string"
        },
        "cyclization_type": {
          "type": "string",
          "oneOf": [
            {
              "enum": ["head_to_tail_amide", "head-to-tail_amide"]
            },
            {
              "pattern": "^Cys-Cys_disulfide(?:,linker=[ACDEFGHIKLMNPQRSTVWY]*)?$"
            }
          ]
        },
        "cyclization_bonds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["atom_1", "atom_2", "bond_type"],
            "properties": {
              "atom_1": {
                "type": "string"
              },
              "atom_2": {
                "type": "string"
              },
              "bond_type": {
                "type": "string"
              }
            }
          }
        },
        "design_pdb_path": {
          "type": ["string", "null"]
        },
        "design_pdb_hash": {
          "type": ["string", "null"]
        },
        "manifest_path": {
          "type": "string"
        }
      }
    },
    "scores": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "object",
          "properties": {
            "global": {"type": "object", "additionalProperties": true},
            "targets": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/target_scores"}
            }
          }
        },
        "plddt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ipsae_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ipsae_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dg_mdm2": {
          "type": "number"
        },
        "dg_mdmx": {
          "type": "number"
        },
        "dg_method": {
          "type": "string"
        },
        "sc_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sc_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dsasa_mdm2": {
          "type": "number",
          "minimum": 0
        },
        "dsasa_mdmx": {
          "type": "number",
          "minimum": 0
        },
        "nc_distance_pre": {
          "type": "number",
          "minimum": 0
        },
        "nc_distance_post": {
          "type": "number",
          "minimum": 0
        },
        "hotspot_cov_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hotspot_cov_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pose_rmsd_mdm2": {
          "type": "number",
          "minimum": 0
        },
        "pose_rmsd_mdmx": {
          "type": "number",
          "minimum": 0
        },
        "seed_convergence_mdm2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed_convergence_mdmx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scrmsd": {
          "type": "number",
          "minimum": 0
        },
        "l1_pass": {
          "type": "boolean"
        },
        "l2_pass": {
          "type": "boolean"
        },
        "l3_pass": {
          "type": "boolean"
        },
        "l4_pass": {
          "type": "boolean"
        },
        "l5_pass": {
          "type": "boolean"
        },
        "l6_pass": {
          "type": "boolean"
        },
        "l7_pass": {
          "type": "boolean"
        },
        "all_layers_pass": {
          "type": "boolean"
        }
      }
    },
    "target_scores": {
      "type": "object",
      "properties": {
        "ipsae": {"type": "number", "minimum": 0, "maximum": 1},
        "ipae": {"type": "number", "minimum": 0},
        "iptm": {"type": "number", "minimum": 0, "maximum": 1},
        "dg": {"type": "number"},
        "sc": {"type": "number", "minimum": 0, "maximum": 1},
        "dsasa": {"type": "number", "minimum": 0},
        "hotspot_cov": {"type": "number", "minimum": 0, "maximum": 1},
        "site_consistency": {"type": ["boolean", "string"]},
        "pose_rmsd": {"type": "number", "minimum": 0},
        "seed_convergence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "tool_trace": {
      "type": "object",
      "required": ["tool_name", "exit_code"],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "input_params": {
          "type": "object"
        },
        "output_path": {
          "type": "string"
        },
        "output_hash": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "stdout_snippet": {
          "type": "string"
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
