 from .errors import PlannerContractError
+
+_COMPUTE_COST_PROTOCOL_PATH = (
+    Path(__file__).resolve().parents[2] / "protocols" / "planner_compute_cost_v1.json"
+)
+
+
+@lru_cache(maxsize=1)
+def _compute_cost_protocol() -> tuple[dict, str]:
+    """Load the versioned cost-estimation protocol and bind its digest."""
+    try:
+        payload = json.loads(_COMPUTE_COST_PROTOCOL_PATH.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise PlannerContractError(
+            "compute_cost_protocol_invalid",
+            f"cannot load compute cost protocol: {_COMPUTE_COST_PROTOCOL_PATH}",
+        ) from exc
+    if not isinstance(payload, dict) or not payload.get("protocol_id"):
+        raise PlannerContractError(
+            "compute_cost_protocol_invalid",
+            "compute cost protocol must be an object with protocol_id",
+        )
+    return payload, file_sha256(_COMPUTE_COST_PROTOCOL_PATH)
+
+
+def _finite_non_negative(value, *, label: str) -> float:
+    try:
+        number = float(value)
+    except (TypeError, ValueError) as exc:
+        raise PlannerContractError(
+            "compute_cost_protocol_invalid", f"{label} must be numeric"
+        ) from exc
+    if not math.isfinite(number) or number < 0:
+        raise PlannerContractError(
+            "compute_cost_protocol_invalid", f"{label} must be finite and non-negative"
+        )
+    return number
+
+
+def _estimated_gpu_minutes(
+    *,
+    parameters: dict,
+    proposal_count: int,
+    candidate_limit: int,
+) -> tuple[float, str, str]:
+    protocol, protocol_sha256 = _compute_cost_protocol()
+    route_rates = protocol.get("route_gpu_minutes_per_proposal") or {}
+    default_proposal = _finite_non_negative(
+        protocol.get("default_gpu_minutes_per_proposal"),
+        label="default_gpu_minutes_per_proposal",
+    )
+    default_candidate = _finite_non_negative(
+        protocol.get("default_gpu_minutes_per_candidate"),
+        label="default_gpu_minutes_per_candidate",
+    )
+
+    design_jobs = parameters.get("design_jobs")
+    if isinstance(design_jobs, list) and design_jobs:
+        total = 0.0
+        for job in design_jobs:
+            if not isinstance(job, dict):
+                continue
+            route = str(job.get("route") or "").upper()
+            rate = _finite_non_negative(
+                route_rates.get(route, default_proposal),
+                label=f"route {route or 'default'} GPU minutes",
+            )
+            try:
+                count = int(job.get("proposal_count") or 0)
+            except (TypeError, ValueError) as exc:
+                raise PlannerContractError(
+                    "compute_cost_input_invalid",
+                    "design job proposal_count must be an integer",
+                ) from exc
+            if count < 0:
+                raise PlannerContractError(
+                    "compute_cost_input_invalid",
+                    "design job proposal_count must be non-negative",
+                )
+            total += count * rate
+    elif candidate_limit > 0:
+        total = candidate_limit * default_candidate
+    else:
+        total = max(proposal_count, 1) * default_proposal
+
+    return (
+        round(total, 3),
+        str(protocol["protocol_id"]),
+        protocol_sha256,
+    )
