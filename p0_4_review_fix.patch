 from __future__ import annotations

 from .errors import PlannerContractError
+
+
+def round_budget_status(state: dict, max_rounds: int) -> dict:
+    """Return the global iteration-budget state.
+
+    Round N is the final allowed round.  Once State already reports N, Planner
+    must not schedule work that would advance to N+1.  Recovery work is handled
+    separately and is never dropped by this guard.
+    """
+    try:
+        current_round = int(state.get("round") or 1)
+        limit = int(max_rounds)
+    except (TypeError, ValueError) as exc:
+        raise PlannerContractError(
+            "planner_round_budget_invalid",
+            "round and max_rounds must be positive integers",
+        ) from exc
+    if current_round < 1 or limit < 1:
+        raise PlannerContractError(
+            "planner_round_budget_invalid",
+            "round and max_rounds must be positive integers",
+        )
+    return {
+        "current_round": current_round,
+        "max_rounds": limit,
+        "exhausted": current_round >= limit,
+        "reason": "max_rounds_exhausted" if current_round >= limit else None,
+    }
+
+
+def retain_budget_allowed_tasks(tasks: list[dict], *, exhausted: bool) -> list[dict]:
+    """Suppress new scientific iteration while preserving mandatory recovery."""
+    if not exhausted:
+        return list(tasks)
+    return [
+        task for task in tasks
+        if task.get("disposition") == "recovery"
+    ]
+
+
+def select_current_best(candidate_rows: list[dict] | None) -> dict | None:
+    """Return a stable best-effort candidate without inventing a new scorer."""
+    rows = [row for row in (candidate_rows or []) if isinstance(row, dict)]
+    if not rows:
+        return None
+
+    def truthy(value) -> bool:
+        return value is True or str(value).strip().casefold() in {"true", "1", "yes"}
+
+    best = next(
+        (
+            row for row in rows
+            if truthy(row.get("all_layers_pass"))
+            or str(row.get("final_status") or "").casefold() == "finalized"
+        ),
+        rows[0],
+    )
+    return {
+        "candidate_id": best.get("candidate_id"),
+        "final_status": best.get("final_status"),
+        "all_layers_pass": truthy(best.get("all_layers_pass")),
+    }

 def _budget_snapshot(state: dict) -> tuple[dict[str, int], int]:
