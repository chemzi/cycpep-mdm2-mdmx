+    def test_resource_request_contains_route_compute_estimate_and_timeout(self):
+        report_path = self._report([
+            self._issue("l2_interface_confidence_low", "iterate_interface_design")
+        ])
+        result = build_plan(
+            critic_report_path=report_path,
+            state=self._state(),
+        )
+        design = result["tasks"][0]
+        request = design["resource_request"]
+        self.assertEqual(request["estimate_status"], "estimated")
+        self.assertGreater(request["estimated_gpu_minutes"], 0)
+        self.assertGreater(request["timeout_seconds"], 0)
+        self.assertEqual(request["estimate_protocol"], "planner_compute_cost_v1")
+        self.assertRegex(request["estimate_protocol_sha256"], r"^[0-9a-f]{64}$")
+
+    def test_max_rounds_stops_new_iteration_but_keeps_recovery(self):
+        state = self._state()
+        state["round"] = 5
+        report_path = self._report([
+            self._issue(
+                "candidate_index_sequence_mismatch",
+                "repair_candidate_index",
+                severity="blocker",
+                priority="P0",
+            )
+        ], verdict="blocked")
+        result = build_plan(
+            critic_report_path=report_path,
+            state=state,
+            config=PlannerConfig(max_rounds=5),
+        )
+        self.assertEqual(result["status"], "recovery_only")
+        self.assertTrue(result["tasks"])
+        self.assertTrue(all(task["disposition"] == "recovery" for task in result["tasks"]))
+        self.assertEqual(result["cycle"]["target_round"], 5)
+
+    def test_plan_budget_exhaustion_returns_current_best_and_does_not_loop(self):
+        state = self._state()
+        state["round"] = 5
+        rows = [
+            {"candidate_id": "C0001", "all_layers_pass": "False", "final_status": "pending"},
+            {"candidate_id": "C0002", "all_layers_pass": "True", "final_status": "finalized"},
+        ]
+        result = plan(
+            state=state,
+            candidate_rows=rows,
+            config=PlannerConfig(max_rounds=5),
+        )
+        self.assertEqual(len(result), 1)
+        self.assertFalse(result[0]["execution_allowed"])
+        self.assertEqual(result[0]["reason"], "max_rounds_exhausted")
+        self.assertEqual(result[0]["best_candidate"]["candidate_id"], "C0002")
