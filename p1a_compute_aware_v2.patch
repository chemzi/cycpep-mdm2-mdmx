+) -> tuple[float, int, str, str]:
+    protocol, protocol_sha256 = _compute_cost_protocol()
+    profile = (protocol.get("resource_profiles") or {}).get(resource_class) or {}
+    gpu_slots = int(profile.get("gpu_job_slots", 1 if resource_class == "gpu" else 0))
+    if gpu_slots < 0:
+        raise PlannerContractError(
+            "compute_cost_protocol_invalid", "gpu_job_slots must be non-negative"
+        )
+    if resource_class != "gpu":
+        return 0.0, gpu_slots, str(protocol["protocol_id"]), protocol_sha256
+    route_rates = protocol.get("route_duration_minutes_per_proposal") or {}
+    default_proposal = _finite_non_negative(
+        protocol.get("default_gpu_duration_minutes_per_proposal"),
+        label="default_gpu_duration_minutes_per_proposal",
+    )
+    default_prediction = _finite_non_negative(
+        protocol.get("default_prediction_duration_minutes_per_candidate"),
+        label="default_prediction_duration_minutes_per_candidate",
+    )
+    design_jobs = parameters.get("design_jobs")
+    if isinstance(design_jobs, list) and design_jobs:
+        duration = 0.0
+        for job in design_jobs:
+            if not isinstance(job, dict):
+                continue
+            route = str(job.get("route") or "").upper()
+            rate = _finite_non_negative(
+                route_rates.get(route, default_proposal),
+                label=f"route {route or 'default'} duration",
+            )
+            count = int(job.get("proposal_count") or 0)
+            if count < 0:
+                raise PlannerContractError(
+                    "compute_cost_input_invalid",
+                    "design job proposal_count must be non-negative",
+                )
+            duration += count * rate
+    elif candidate_limit > 0:
+        duration = int(candidate_limit) * default_prediction
+    else:
+        duration = max(int(proposal_count), 1) * default_proposal
+    return round(duration, 3), gpu_slots, str(protocol["protocol_id"]), protocol_sha256
