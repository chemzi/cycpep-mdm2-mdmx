{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapeptide.local/schemas/prediction-artifacts-v1.json",
  "title": "NovaPeptide Prediction raw artifact bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "sequence", "global", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_id": {"type": "string", "pattern": "^C\\d{4,}$"},
    "sequence": {
      "type": "string",
      "pattern": "^[ACDEFGHIKLMNPQRSTVWY]{8,20}$"
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monomer_predictions"],
      "properties": {
        "monomer_predictions": {
          "type": "array",
          "items": {"$ref": "#/$defs/prediction"}
        },
        "post_relax_pdb": {"type": "string"},
        "post_relax_pdb_sha256": {"$ref": "#/$defs/sha256"},
        "post_relax_metadata": {
          "type": "string",
          "description": "JSON provenance for the relax run; required by L4 when post_relax_pdb is present."
        },
        "post_relax_metadata_sha256": {"$ref": "#/$defs/sha256"},
        "design_reference_pdb": {"type": "string"},
        "design_reference_pdb_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targets": {
      "type": "object",
      "description": "Keys are the exact required target IDs from project_config.",
      "additionalProperties": {"$ref": "#/$defs/target_artifacts"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictor", "seed", "pdb"],
      "properties": {
        "predictor": {
          "type": "string",
          "minLength": 1,
          "description": "Execution tool name; it must match metadata.tool. L6 independence is counted by metadata.model_family, not this label."
        },
        "seed": {"type": "integer"},
        "primary": {"type": "boolean"},
        "pdb": {"type": "string"},
        "pdb_sha256": {"$ref": "#/$defs/sha256"},
        "pae": {"type": "string"},
        "pae_sha256": {"$ref": "#/$defs/sha256"},
        "metadata": {
          "type": "string",
          "description": "Required for L6. JSON must record tool, tool_commit or tool_version, model_family, model_id, and seed."
        },
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "binder_chain": {"type": "string", "minLength": 1}
      }
    },
    "target_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complex_predictions"],
      "properties": {
        "target_chain": {"type": "string", "minLength": 1},
        "complex_predictions": {
          "type": "array",
          "items": {"$ref": "#/$defs/prediction"}
        },
        "prodigy_output": {"type": "string"},
        "prodigy_output_sha256": {"$ref": "#/$defs/sha256"},
        "prodigy_outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/scored_output"}
        },
        "rosetta_output": {"type": "string"},
        "rosetta_output_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scored_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predictor", "model_id", "seed", "prediction_pdb_sha256", "output"],
      "properties": {
        "predictor": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "prediction_pdb_sha256": {"$ref": "#/$defs/sha256"},
        "output": {"type": "string"},
        "output_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
